
{
  parserClass="de.mithnar.plugin.asarasm.parser.AsarParser"
  parserUtilClass="de.mithnar.plugin.asarasm.parser.AsarParserUtil"
  psiClassPrefix="Asar"
  psiImplClassSuffix="Impl"
  psiPackage="de.mithnar.plugin.asarasm.psi"
  psiImplPackage="de.mithnar.plugin.asarasm.psi.impl"
  elementTypeHolderClass="de.mithnar.plugin.asarasm.psi.AsarTypes"
  elementTypeClass="de.mithnar.plugin.asarasm.psi.AsarElementType"
  tokenTypeClass="de.mithnar.plugin.asarasm.psi.AsarTokenType"
}

// Top-level structure

root ::= (NEWLINE_TOKEN | line)*

line ::= item (COLON_TOKEN? item)* {recoverWhile=line_recover}

private line_recover ::= !(
    NEWLINE_TOKEN
  | OPCODE_TOKEN | IMPLIED_OPCODE_TOKEN | BLOCK_MOVE_OPCODE_TOKEN
  | BRANCH_OPCODE_TOKEN | JUMP_OPCODE_TOKEN
  | LABEL_TOKEN | COMMENT_TOKEN | CONSTANT_TOKEN
  | IDENTIFIER_TOKEN
  | PLUS_TOKEN | MINUS_TOKEN | PERCENT_TOKEN
  )

item ::= labelDefinition
       | localLabelDefinition
       | anonymousLabelDefinition
       | constantDefinition
       | impliedInstruction
       | blockMoveInstruction
       | genericInstruction
       | branchInstruction
       | jumpInstruction
       | directive
       | macroCall
       | COMMENT_TOKEN

// Labels

labelDefinition ::= LABEL_TOKEN | IDENTIFIER_TOKEN COLON_TOKEN  {
    mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarLabelDefinitionMixin"
}
localLabelDefinition ::= LOCAL_LABEL_TOKEN  {
    mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarLocalLabelDefinitionMixin"
}
localLabelReference  ::= LOCAL_LABEL_TOKEN  {
    mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarLocalLabelReferenceMixin"
}
anonymousLabelDefinition ::= plusLabel | minusLabel  {
    mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarAnonymousLabelDefinitionMixin"
}
anonymousLabelReference ::= plusLabel | minusLabel  {
    mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarAnonymousLabelReferenceMixin"
}
plusLabel       ::= PLUS_TOKEN+
minusLabel     ::= MINUS_TOKEN+

// Constants

constantDefinition ::= CONSTANT_TOKEN (ASSIGN_TOKEN | HASH_ASSIGN_TOKEN) expression {mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarConstantDefinitionMixin"}
constantReference  ::= CONSTANT_TOKEN {mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarConstantReferenceMixin"}

// Instructions

genericInstruction   ::= OPCODE_TOKEN operandList? {pin=1}
impliedInstruction   ::= IMPLIED_OPCODE_TOKEN repeatCount? {pin=1}
blockMoveInstruction ::= BLOCK_MOVE_OPCODE_TOKEN expression COMMA_TOKEN expression {pin=1}
branchInstruction    ::= BRANCH_OPCODE_TOKEN branchTarget {pin=1}
jumpInstruction      ::= JUMP_OPCODE_TOKEN jumpTarget {pin=1}

repeatCount ::= HASH_TOKEN expression

// Branch / jump targets

branchTarget ::= symbolReferenceTarget
               | anonymousLabelReference
               | expressionTarget

jumpTarget ::= indexedIndirectMode
             | indirectIndexedOrIndirectMode
             | longIndirectIndexedMode
             | symbolReferenceTarget
             | expressionTarget

labelReference    ::= IDENTIFIER_TOKEN  {mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarLabelReferenceMixin"}

symbolReferenceTarget ::= labelReference | localLabelReference | constantReference
private expressionTarget ::= expression

// Directives

directive ::= asarDirective
            | namespaceConfigurationDirective
            | namespaceDirective
            | dataDirective
            | orgDirective
            | baseDirective
            | skipDirective
            | bankDirective
            | dpbaseDirective
            | optimizeDirective
            | pushpcDirective
            | pullpcDirective
            | pushbaseDirective
            | pullbaseDirective
            | assertDirective
            | functionDefinition
            | incbinDirective
            | incsrcDirective
            | includeDirective
            | includefromDirective
            | printDirective
            | romDirective
            | headerDirective
            | warnpcDirective
            | freespaceDirective
            | freespacebyteDirective
            | autocleanDirective
            | protDirective
            | tableDirective
            | cleartableDirective
            | padbyteDirective
            | padDirective
            | fillbyteDirective
            | fillDirective
            | archDirective
            | mathDirective
            | checkDirective
            | macroDefinition
            | endmacroDirective
            | ifDirective
            | elseifDirective
            | elseDirective
            | endifDirective
            | whileDirective
            | endwhileDirective

// Compatibility

asarDirective ::= <<kw_asar>> ASAR_VERSION_TOKEN {pin=1}
namespaceConfigurationDirective ::= <<kw_namespace>> <<kw_nested>>  namespaceOnOff {pin=2}
namespaceOnOff ::=  <<kw_on>> | <<kw_off>>

// Data & output

dataDirective   ::= <<kw_db>> dataArgumentList
                  | <<kw_dw>> dataArgumentList
                  | <<kw_dl>> dataArgumentList
                  | <<kw_dd>> dataArgumentList {pin(".*")=1}

// Program Counter

orgDirective                    ::= <<kw_org>> expression {pin=1}
baseDirective                   ::= <<kw_base>> (<<kw_off>> | expression) {pin=1}
skipDirective                   ::= skipAlignDirective
                                  | <<kw_skip>> expression {pin(".*")=1}
private skipAlignDirective      ::= <<kw_skip>> <<kw_align>> expression (<<kw_offset>> expression)? {pin=2}
bankDirective                   ::= <<kw_bank>> bankArgument {pin=1}
dpbaseDirective                 ::= <<kw_dpbase>> expression {pin=1}
optimizeDirective               ::= <<kw_optimize>> optimizeArgument {pin=1}
pushpcDirective                 ::= <<kw_pushpc>>
pullpcDirective                 ::= <<kw_pullpc>>
pushbaseDirective               ::= <<kw_pushbase>>
pullbaseDirective               ::= <<kw_pullbase>>
warnpcDirective                 ::= <<kw_warnpc>> expression {pin=1}
private bankArgument            ::= <<kw_noassume>> | <<kw_auto>> | expression
private optimizeArgument        ::= <<kw_dp>> optimizeDpArgument
                                  | <<kw_address>> optimizeAddressArgument {pin(".*")=1}
private optimizeDpArgument      ::= <<kw_none>> | <<kw_ram>> | <<kw_always>>
private optimizeAddressArgument ::= <<kw_default>> | <<kw_ram>> | <<kw_mirrors>>

assertDirective ::= <<kw_assert>> expression (COMMA_TOKEN expression)* (COMMA_TOKEN STRING_TOKEN)? {pin=1}

incbinDirective ::= <<kw_incbin>> STRING_TOKEN incbinRange? {pin=1}

incsrcDirective ::= <<kw_incsrc>> (STRING_TOKEN | IDENTIFIER_TOKEN) {
    mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarIncludeDirectiveMixin"
    pin=1
}
includefromDirective ::= <<kw_includefrom>> (STRING_TOKEN | IDENTIFIER_TOKEN) {
    mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarIncludeDirectiveMixin"
    pin=1
}
includeDirective ::= <<kw_include>> | <<kw_includeonce>>


printDirective  ::= <<kw_print>> printArgumentList?
                  | <<kw_error>> printArgumentList? {pin(".*")=1}

private incbinRange ::= COLON_TOKEN expression COLON_TOKEN expression
private dataArgumentList  ::= expression (COMMA_TOKEN expression)*
private printArgumentList ::= printArgument (COMMA_TOKEN printArgument)*

printArgument     ::= STRING_TOKEN | expression

// header

romDirective    ::= <<kw_lorom>>
                  | <<kw_hirom>>
                  | <<kw_sa1rom>> sa1romArgs?
                  | <<kw_fullsa1rom>>
                  | <<kw_sfxrom>>
                  | <<kw_norom>>
                  | <<kw_exlorom>>
                  | <<kw_exhirom>> {pin(".*")=1}
private sa1romArgs ::= NUMBER_TOKEN COMMA_TOKEN NUMBER_TOKEN COMMA_TOKEN NUMBER_TOKEN COMMA_TOKEN NUMBER_TOKEN

headerDirective ::= <<kw_header>>
                  | <<kw_noheader>>


// freespace

freespaceDirective ::= <<kw_freespace>> freespaceParams
                     | <<kw_freecode>> freespaceFlags?
                     | <<kw_freedata>> freespaceFlags? {pin(".*")=1}

//TODO: Implement specific flags in Annotator later
private freespaceParams  ::= IDENTIFIER_TOKEN (COMMA_TOKEN freespaceFlag)*
private freespaceFlags ::= freespaceFlag (COMMA_TOKEN freespaceFlag)*
private freespaceFlag  ::= IDENTIFIER_TOKEN | NUMBER_TOKEN

freespacebyteDirective ::= <<kw_freespacebyte>> expression {pin=1}
autocleanDirective ::= <<kw_autoclean>> autocleanTarget {pin=1}
autocleanTarget ::= autocleanJumpTarget | expression
autocleanJumpTarget ::= JUMP_OPCODE_TOKEN expression | <<kw_dl>> expression
protDirective ::= <<kw_prot>> expression (COMMA_TOKEN expression)* {pin=1}

// File includes & tables

tableDirective      ::= <<kw_table>> STRING_TOKEN (COMMA_TOKEN IDENTIFIER_TOKEN)? {pin=1}
cleartableDirective ::= <<kw_cleartable>>

// Padding & filling

padbyteDirective  ::= <<kw_padbyte>> expression {pin=1}
padDirective      ::= <<kw_pad>> expression {pin=1}
fillbyteDirective ::= <<kw_fillbyte>> expression {pin=1}
fillDirective     ::= <<kw_fill>> expression {pin=1}

// Architecture & math mode

archDirective  ::= <<kw_arch>> IDENTIFIER_TOKEN {pin=1}
mathDirective  ::= <<kw_math>> IDENTIFIER_TOKEN IDENTIFIER_TOKEN {pin=1}
checkDirective ::= <<kw_check>> IDENTIFIER_TOKEN expression {pin=1}

// Namespace

namespaceDirective ::= <<kw_namespace>> namespaceName {pin=1}
private namespaceName ::= IDENTIFIER_TOKEN | MACRO_PARAM_TOKEN

// Conditional assembly

ifDirective     ::= <<kw_if>> expression {pin=1}
elseifDirective ::= <<kw_elseif>> expression {pin=1}
elseDirective   ::= <<kw_else>>
endifDirective  ::= <<kw_endif>>

// Loops

whileDirective    ::= <<kw_while>> expression {pin=1}
endwhileDirective ::= <<kw_endwhile>>

// Function Definition

functionDefinition ::= <<kw_function>> IDENTIFIER_TOKEN LPAREN_TOKEN functionParamNames? RPAREN_TOKEN ASSIGN_TOKEN expression {pin=1}
private functionParamNames ::= IDENTIFIER_TOKEN (COMMA_TOKEN IDENTIFIER_TOKEN)*

// Function Call

functionCall ::= IDENTIFIER_TOKEN LPAREN_TOKEN functionArgList? RPAREN_TOKEN
private functionArgList ::= expression (COMMA_TOKEN expression)*

// Macro definition

macroDefinition   ::= <<kw_macro>> IDENTIFIER_TOKEN macroParamList? {pin=1}
endmacroDirective ::= <<kw_endmacro>>

macroParamList    ::= LPAREN_TOKEN macroParamNames? RPAREN_TOKEN
private macroParamNames   ::= IDENTIFIER_TOKEN (COMMA_TOKEN IDENTIFIER_TOKEN)*

// Macro calls

macroCall         ::= PERCENT_TOKEN IDENTIFIER_TOKEN macroArguments?
macroArguments    ::= LPAREN_TOKEN macroArgumentList? RPAREN_TOKEN
private macroArgumentList ::= macroArgument (COMMA_TOKEN macroArgument)*
macroArgument     ::= STRING_TOKEN | expression

// Operands & addressing modes

operandList ::= operand (COMMA_TOKEN operand)*

operand ::= hashOperand                         // #expr <- (immediate mode or repeat shorthand)
            | stackRelativeIndirectIndexedMode  // (expr,S),Y
            | indexedIndirectMode               // (expr,X)
            | indirectIndexedOrIndirectMode     // (expr),Y  or  (expr)
            | longIndirectIndexedMode           // [expr],Y  or  [expr]
            | indexedMode                       // expr,X / expr,Y
            | accumulatorOperand                // A
            | stackOperand                      // S
            | expression                        // bare expression

hashOperand                         ::= HASH_TOKEN expression
stackRelativeIndirectIndexedMode    ::= LPAREN_TOKEN expression COMMA_TOKEN <<kw_s>> RPAREN_TOKEN COMMA_TOKEN <<kw_y>>
indexedIndirectMode                 ::= LPAREN_TOKEN expression COMMA_TOKEN indexRegister RPAREN_TOKEN
indirectIndexedOrIndirectMode       ::= LPAREN_TOKEN expression RPAREN_TOKEN [COMMA_TOKEN indexRegister]
longIndirectIndexedMode             ::= LBRACKET_TOKEN expression RBRACKET_TOKEN [COMMA_TOKEN indexRegister]
indexedMode                         ::= expression COMMA_TOKEN indexRegister
accumulatorOperand                  ::= <<kw_a>>
stackOperand                        ::= <<kw_s>>

indexRegister ::= <<kw_x>> | <<kw_y>> | <<kw_s>>

// Expressions (precedence lowest to highest)

private expression               ::= logicalOrExpression
private logicalOrExpression      ::= logicalAndExpression (LOGICAL_OR_TOKEN logicalAndExpression)*
private logicalAndExpression     ::= comparisonExpression (LOGICAL_AND_TOKEN comparisonExpression)*
private comparisonExpression     ::= orExpression (comparisonOp orExpression)*
private orExpression             ::= xorExpression (PIPE_TOKEN xorExpression)*
private xorExpression            ::= andExpression (CARET_TOKEN andExpression)*
private andExpression            ::= additiveExpression (AMPERSAND_TOKEN additiveExpression)*
private additiveExpression       ::= multiplicativeExpression (addOp multiplicativeExpression)*
private multiplicativeExpression ::= shiftExpression (mulOp shiftExpression)*
private shiftExpression          ::= prefixExpression (shiftOp prefixExpression)*
private prefixExpression         ::= prefixOperator* primaryExpression

private comparisonOp ::= EQ_TOKEN | NEQ_TOKEN | LT_TOKEN | GT_TOKEN | LTE_TOKEN | GTE_TOKEN
private shiftOp ::= SHIFT_LEFT_TOKEN | SHIFT_RIGHT_TOKEN
private addOp ::= PLUS_TOKEN | MINUS_TOKEN
private mulOp ::= STAR_TOKEN | SLASH_TOKEN | PERCENT_TOKEN

prefixOperator ::= LT_TOKEN
                 | GT_TOKEN
                 | MINUS_TOKEN
                 | TILDE_TOKEN

pcExpression ::= <<kw_pc>>

primaryExpression ::= NUMBER_TOKEN
                    | STRING_TOKEN
                    | MACRO_PARAM_TOKEN
                    | localLabelReference
                    | functionCall
                    | pcExpression
                    | labelReference
                    | constantReference
                    | LPAREN_TOKEN expression RPAREN_TOKEN  {mixin="de.mithnar.plugin.asarasm.psi.mixin.AsarPrimaryExpressionMixin"}